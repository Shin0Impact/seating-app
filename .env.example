# From Supabase: Project settings > API. The anon/publishable key is meant to be public; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Public address of the site, used to build the invite links (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
